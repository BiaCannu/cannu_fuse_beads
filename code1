function makeCanvas(w, h){
  if (typeof OffscreenCanvas !== "undefined") return new OffscreenCanvas(w, h);
  const c = document.createElement("canvas");
  c.width = w; c.height = h;
  return c;
}

function fillHoles(mask,W,H){const visited=new Uint8Array(W*H),q=[];for(let x=0;x<W;x++){if(mask[x]<128){visited[x]=1;q.push(x)}if(mask[(H-1)*W+x]<128){visited[(H-1)*W+x]=1;q.push((H-1)*W+x)}}for(let y=0;y<H;y++){if(mask[y*W]<128){visited[y*W]=1;q.push(y*W)}if(mask[y*W+W-1]<128){visited[y*W+W-1]=1;q.push(y*W+W-1)}}while(q.length){const i=q.pop(),x=i%W,y=(i/W)|0;for(const n of[x>0?i-1:-1,x<W-1?i+1:-1,y>0?i-W:-1,y<H-1?i+W:-1])if(n>=0&&!visited[n]&&mask[n]<128){visited[n]=1;q.push(n)}}for(let i=0;i<W*H;i++)if(mask[i]<128&&!visited[i])mask[i]=255;}

/* Guided filter — substitui bilateral: Θ(N) com constante ~12 vs Θ(49N) */
function boxMean(src, w, h, r, out){
  const tmp = new Float32Array(w*h);
  const inv = 1/((2*r+1)*(2*r+1));
  for(let y=0;y<h;y++){
    let sum=0; const row=y*w;
    for(let x=-r;x<=r;x++) sum += src[row+Math.max(0,Math.min(w-1,x))];
    for(let x=0;x<w;x++){
      tmp[row+x]=sum;
      sum += src[row+Math.min(w-1,x+r+1)] - src[row+Math.max(0,x-r)];
    }
  }
  for(let x=0;x<w;x++){
    let sum=0;
    for(let y=-r;y<=r;y++) sum += tmp[Math.max(0,Math.min(h-1,y))*w+x];
    for(let y=0;y<h;y++){
      out[y*w+x]=sum*inv;
      sum += tmp[Math.min(h-1,y+r+1)*w+x] - tmp[Math.max(0,y-r)*w+x];
    }
  }
}
function guidedFilter(src, w, h, r=3, eps=0.01){
  const N=w*h;
  const I=new Float32Array(N), II=new Float32Array(N);
  for(let i=0,p=0;i<src.length;i+=4,p++){
    I[p]=(0.299*src[i]+0.587*src[i+1]+0.114*src[i+2])/255;
    II[p]=I[p]*I[p];
  }
  const meanI=new Float32Array(N), meanII=new Float32Array(N);
  boxMean(I,w,h,r,meanI); boxMean(II,w,h,r,meanII);
  const varI=new Float32Array(N);
  for(let i=0;i<N;i++) varI[i]=meanII[i]-meanI[i]*meanI[i];
  const out=new Uint8ClampedArray(src.length);
  const p_ch=new Float32Array(N), mean_p=new Float32Array(N), Ip=new Float32Array(N), mean_Ip=new Float32Array(N);
  const a=new Float32Array(N), b=new Float32Array(N), mean_a=new Float32Array(N), mean_b=new Float32Array(N);
  for(let c=0;c<3;c++){
    for(let i=0,p=0;i<src.length;i+=4,p++) p_ch[p]=src[i+c]/255;
    boxMean(p_ch,w,h,r,mean_p);
    for(let i=0;i<N;i++) Ip[i]=I[i]*p_ch[i];
    boxMean(Ip,w,h,r,mean_Ip);
    for(let i=0;i<N;i++){
      const cov_Ip = mean_Ip[i]-meanI[i]*mean_p[i];
      a[i] = cov_Ip/(varI[i]+eps);
      b[i] = mean_p[i]-a[i]*meanI[i];
    }
    boxMean(a,w,h,r,mean_a); boxMean(b,w,h,r,mean_b);
    for(let i=0,p=0;i<src.length;i+=4,p++){
      if(src[i+3]<128){ out[i+c]=src[i+c]; }
      else { out[i+c]=Math.round(Math.max(0,Math.min(255,(mean_a[p]*I[p]+mean_b[p])*255))); }
    }
  }
  for(let i=3;i<src.length;i+=4) out[i]=src[i];
  return out;
}

function unsharp(src,w,h,amount){
  const out=new Uint8ClampedArray(src.length),tmp=new Uint8ClampedArray(src.length);
  for(let y=0;y<h;y++)for(let x=0;x<w;x++){
    const i=(y*w+x)*4;
    if(src[i+3]<128){tmp[i]=src[i];tmp[i+1]=src[i+1];tmp[i+2]=src[i+2];tmp[i+3]=src[i+3];continue;}
    let r=0,g=0,b=0,a=0,n=0;
    for(let dy=-1;dy<=1;dy++){const ny=Math.max(0,Math.min(h-1,y+dy));for(let dx=-1;dx<=1;dx++){const nx=Math.max(0,Math.min(w-1,x+dx)),p=(ny*w+nx)*4;if(src[p+3]<128)continue;r+=src[p];g+=src[p+1];b+=src[p+2];a+=src[p+3];n++;}}
    if(n>0){tmp[i]=r/n;tmp[i+1]=g/n;tmp[i+2]=b/n;tmp[i+3]=a/n;}else{tmp[i]=src[i];tmp[i+1]=src[i+1];tmp[i+2]=src[i+2];tmp[i+3]=src[i+3];}
  }
  for(let i=0;i<src.length;i+=4){
    if(src[i+3]<128){out[i]=src[i];out[i+1]=src[i+1];out[i+2]=src[i+2];out[i+3]=src[i+3];continue;}
    out[i]=Math.max(0,Math.min(255,src[i]+amount*(src[i]-tmp[i])));
    out[i+1]=Math.max(0,Math.min(255,src[i+1]+amount*(src[i+1]-tmp[i+1])));
    out[i+2]=Math.max(0,Math.min(255,src[i+2]+amount*(src[i+2]-tmp[i+2])));
    out[i+3]=src[i+3];
  }
  return out;
}
function sobelMap(src,w,h){
  const gray=new Float32Array(w*h);
  for(let i=0,p=0;i<src.length;i+=4,p++)gray[p]=0.299*src[i]+0.587*src[i+1]+0.114*src[i+2];
  const mag=new Float32Array(w*h);
  for(let y=1;y<h-1;y++)for(let x=1;x<w-1;x++){
    const i=y*w+x;
    const gx=(gray[i-w+1]+2*gray[i+1]+gray[i+w+1])-(gray[i-w-1]+2*gray[i-1]+gray[i+w-1]);
    const gy=(gray[i+w-1]+2*gray[i+w]+gray[i+w+1])-(gray[i-w-1]+2*gray[i-w]+gray[i-w+1]);
    mag[i]=Math.sqrt(gx*gx+gy*gy);
  }
