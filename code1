/* ============================================================
   WORKER (opcional, com fallback robusto)
   ============================================================ */
let workerInstance = null;
let workerReady = null;
const pendingConverts = new Map();
let convertSeq = 0;

function initWorker(){
  if (workerInstance) return workerInstance;
  if (typeof Worker === "undefined") return null;
  try {
    const fns = [hex2rgb, rgb2lab, lum, nearest, fillHoles, boxMean, guidedFilter, unsharp, sobelMap, clahe, tunePixels, stretchLum, magicWand, borderFlood, makeCanvas, convert, clampPlates];
    const workerSrc = `
      const PLATE = 29, MAX_PLATES = 4;
      const clampPlates = ${clampPlates.toString()};
      const PAL_RAW = ${JSON.stringify(PAL_RAW)};
      const PAL = PAL_RAW.split(";").map(s=>{const [code,name,h]=s.split("|");const hex="#"+h;const [r,g,b]=hex2rgb(hex);return{code,name,hex,lab:rgb2lab(r,g,b)};});
      const PALBY = Object.fromEntries(PAL.map(p=>[p.code,p]));
      const slim = (p)=>({code:p.code,name:p.name,hex:p.hex});
      ${fns.map(f=>f.toString()).join("\n")}
      self.onmessage = function(e){
        try {
          const {id, bitmap, opts} = e.data;
          const result = convert(bitmap, opts);
          const cellsBuf = result && result.cells ? result.cells.buffer : null;
          self.postMessage({id, ok:true, result}, cellsBuf ? [cellsBuf] : []);
        } catch(err){
          self.postMessage({id, ok:false, error: String(err && err.message || err)});
        }
      };
    `;
    const blob = new Blob([workerSrc], {type:"application/javascript"});
    workerInstance = new Worker(URL.createObjectURL(blob));
    workerInstance.onmessage = (e) => {
      const {id, ok, result, error} = e.data;
      const p = pendingConverts.get(id);
      if (!p) return;
      pendingConverts.delete(id);
      if (ok) p.resolve(result);
      else p.reject(new Error(error || "Worker error"));
    };
    workerInstance.onerror = (err) => {
      console.warn("Worker error", err);
      // Rejeita todos pendentes
      for (const [id, p] of pendingConverts) p.reject(err);
      pendingConverts.clear();
    };
    return workerInstance;
  } catch (e) {
    console.warn("Worker creation failed", e);
    return null;
  }
}

function convertAsync(cropped, opts){
  const w = initWorker();
  if (!w) {
    try { return Promise.resolve(convert(cropped, opts)); }
    catch (e) { return Promise.reject(e); }
  }
  return new Promise((resolve, reject) => {
    const id = ++convertSeq;
    pendingConverts.set(id, {resolve, reject});
    // Timeout de 8s
    setTimeout(() => {
      if (pendingConverts.has(id)) {
        pendingConverts.delete(id);
        reject(new Error("Worker timeout"));
      }
    }, 8000);
    if (typeof createImageBitmap === "undefined") {
      // Fallback síncrono
      pendingConverts.delete(id);
      try { resolve(convert(cropped, opts)); } catch (e) { reject(e); }
      return;
    }
    createImageBitmap(cropped).then(bitmap => {
      w.postMessage({id, bitmap, opts}, [bitmap]);
    }).catch(err => {
      pendingConverts.delete(id);
      reject(err);
    });
  });
}

async function convertSafe(cropped, opts){
  try {
    return await convertAsync(cropped, opts);
  } catch (e) {
    console.warn("Worker failed, falling back to main thread", e);
    return convert(cropped, opts);
  }
}

