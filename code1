function clahe(src,w,h,strength=0.5){
  const tilesX=8,tilesY=8,tileW=Math.ceil(w/tilesX),tileH=Math.ceil(h/tilesY),lums=new Float32Array(w*h);
  for(let i=0,p=0;i<src.length;i+=4,p++)lums[p]=0.299*src[i]+0.587*src[i+1]+0.114*src[i+2];
  const luts=[];
  for(let ty=0;ty<tilesY;ty++)for(let tx=0;tx<tilesX;tx++){
    const hist=new Uint32Array(256),x0=tx*tileW,x1=Math.min(w,x0+tileW),y0=ty*tileH,y1=Math.min(h,y0+tileH);
    let n=0;
    for(let y=y0;y<y1;y++)for(let x=x0;x<x1;x++){if(src[(y*w+x)*4+3]<128)continue;hist[Math.min(255,Math.max(0,lums[y*w+x]|0))]++;n++;}
    if(n===0){const id=new Uint8Array(256);for(let i=0;i<256;i++)id[i]=i;luts.push(id);continue;}
    const clipLimit=Math.max(1,Math.floor(3*n/256));
    let excess=0;
    for(let i=0;i<256;i++){if(hist[i]>clipLimit){excess+=hist[i]-clipLimit;hist[i]=clipLimit;}}
    const add=Math.floor(excess/256);
    for(let i=0;i<256;i++)hist[i]+=add;
    const cdf=new Uint32Array(256);
    let sum=0;
    for(let i=0;i<256;i++){sum+=hist[i];cdf[i]=sum;}
    const cdfMin=cdf[0],denom=Math.max(1,n-cdfMin);
    const lut=new Uint8Array(256);
    for(let i=0;i<256;i++)lut[i]=Math.min(255,Math.round((cdf[i]-cdfMin)*255/denom));
    luts.push(lut);
  }
  const out=new Uint8ClampedArray(src.length);
  for(let y=0;y<h;y++)for(let x=0;x<w;x++){
    const i=(y*w+x)*4;
    if(src[i+3]<128){out[i]=src[i];out[i+1]=src[i+1];out[i+2]=src[i+2];out[i+3]=src[i+3];continue;}
    const fx=x/tileW-0.5,fy=y/tileH-0.5;
    const tx0=Math.max(0,Math.min(tilesX-1,Math.floor(fx))),ty0=Math.max(0,Math.min(tilesY-1,Math.floor(fy)));
    const tx1=Math.min(tilesX-1,tx0+1),ty1=Math.min(tilesY-1,ty0+1);
    const wx=Math.max(0,Math.min(1,fx-tx0)),wy=Math.max(0,Math.min(1,fy-ty0));
    const lumV=Math.min(255,Math.max(0,lums[y*w+x]|0));
    const v00=luts[ty0*tilesX+tx0][lumV],v10=luts[ty0*tilesX+tx1][lumV],v01=luts[ty1*tilesX+tx0][lumV],v11=luts[ty1*tilesX+tx1][lumV];
    const nl=v00*(1-wx)*(1-wy)+v10*wx*(1-wy)+v01*(1-wx)*wy+v11*wx*wy;
    const delta=(nl-lums[y*w+x])*strength;
    out[i]=Math.max(0,Math.min(255,src[i]+delta));
    out[i+1]=Math.max(0,Math.min(255,src[i+1]+delta));
    out[i+2]=Math.max(0,Math.min(255,src[i+2]+delta));
    out[i+3]=src[i+3];
  }
  return out;
}
function tunePixels(d,contrast,saturation){
  if(contrast===1&&saturation===1)return d;
  for(let i=0;i<d.length;i+=4){
